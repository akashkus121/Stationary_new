@model IEnumerable<Stationary.Models.Product>

@{
    ViewData["Title"] = "Product Catalog";
}

<link rel="stylesheet" href="~/css/product-catalog.css?v=1" />

<div class="cart-page-button">
    <a href="@Url.Action("Cart", "User")" class="cart-btn">
        Go to Cart
        <span id="cart-count">0</span>
    </a>
</div>


<div class="catalog-container">
    <div class="catalog-header">
        <h2 class="catalog-title">Product Catalog</h2>
        <p class="catalog-subtitle">Browse our stationary collection</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin-bottom: 20px; padding: 15px; border: 1px solid #f5c6cb; background: #f8d7da; color: #721c24; border-radius: 8px;">
            <i class="fas fa-times-circle"></i>
            @TempData["Error"]
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="margin-bottom: 20px; padding: 15px; border: 1px solid #c3e6cb; background: #d4edda; color: #155724; border-radius: 8px;">
            <i class="fas fa-check-circle"></i>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning" style="margin-bottom: 20px; padding: 15px; border: 1px solid #f1c40f; background: #fff3cd; color: #856404; border-radius: 8px;">
            <i class="fas fa-exclamation-triangle"></i>
            @TempData["Warning"]
        </div>
    }

    <div class="search-container">
        <form method="get" action="@Url.Action("Index")" class="search-form" id="searchForm">
            <div class="search-group">
                <input type="text" name="search" class="search-input"
                       placeholder="Search by product name..."
                       value="@ViewBag.Search" />
            </div>
            <div class="search-group">
                <input type="text" name="category" class="search-input"
                       placeholder="Search by category..."
                       value="@ViewBag.Category" />
            </div>
            <button type="submit" class="search-btn">
                <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                Search
            </button>
        </form>
    </div>


    <div class="loading-container">
        <div class="loading-spinner"></div>
        <p>Searching products...</p>
    </div>

    <div class="products-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="product-card">
                    <div class="product-image-container">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath" alt="@item.Name" class="product-image" />
                        }
                        <div class="product-image-placeholder" style="@(!string.IsNullOrEmpty(item.ImagePath) ? "display: none;" : "")">
                            <svg fill="currentColor" viewBox="0 0 24 24" width="48" height="48">
                                <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                            </svg>
                        </div>
                    </div>
                    <div class="product-content">
                        <h4 class="product-name">@item.Name</h4>
                        <span class="product-category">@item.Category</span>
                        <div class="product-price">$@item.Price.ToString("F2")</div>
                        
                        <!-- Stock Information -->
                        <div class="stock-info">
                            @if (item.StockQuantity > 0)
                            {
                                <span class="stock-available">@item.StockQuantity in stock</span>
                            }
                            else
                            {
                                <span class="stock-out">Out of stock</span>
                            }
                        </div>

                        <div class="quantity-controls">
                            <button type="button" class="decrease-btn" data-id="@item.Id" @(item.StockQuantity <= 0 ? "disabled" : "")>-</button>
                            <span class="quantity" id="qty-@item.Id">1</span>
                            <button type="button" class="increase-btn" data-id="@item.Id" data-max="@item.StockQuantity" @(item.StockQuantity <= 0 ? "disabled" : "")>+</button>
                            <button type="button" class="add-to-cart-btn" data-id="@item.Id" data-max="@item.StockQuantity" @(item.StockQuantity <= 0 ? "disabled" : "")>
                                @(item.StockQuantity <= 0 ? "Out of Stock" : "Add to Cart")
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-products">
                <svg class="no-products-icon" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                </svg>
                <h3>No products found</h3>
                <p>Try adjusting your search criteria or browse all products.</p>
            </div>
        }
    </div>
</div>
<!-- Include jQuery first -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Your script second -->
<script src="~/js/product-catalog.js"></script>

